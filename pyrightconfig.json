{
  "include": [
    "src",
    "tests",
    "primer",
    "quality",
    "timing",
    "eq",
    "harmonics_transitions"
  ],
  "exclude": [
    "**/__pycache__",
    ".venv"
  ],
  "reportUnusedExpression": "warning",
  "executionEnvironments": [
    {
      "root": "quality",
      "reportUnusedExpression": "none"
    },
    {
      "root": "timing",
      "reportUnusedExpression": "none"
    }
  ]
}
